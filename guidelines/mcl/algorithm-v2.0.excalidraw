    {
      "id": "5b3745f5ba3ebb18f9b6",
      "type": "text",
      "x": 54,
      "y": 1790,
      "width": 892,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
