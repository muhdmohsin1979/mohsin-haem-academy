    {
      "id": "0beac02246bede1ffd27",
      "type": "text",
      "x": 529,
      "y": 1540,
      "width": 417,
      "height": 122,
      "angle": 0,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 261045216,
      "version": 1,
      "versionNonce": 86056424,
      "isDeleted": false,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 2,
      "text": "Licensed, no demonstrated national route: pirtobrutinib\nand liso-cel, each within its exact indication.\nNo current MCL licence: bispecific options.\nEvery option requires exact live route confirmation.\nNo national route does not prove absolute\nunavailability, but non-routine access must never be\nimplied.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Licensed, no demonstrated national route: pirtobrutinib\nand liso-cel, each within its exact indication.\nNo current MCL licence: bispecific options.\nEvery option requires exact live route confirmation.\nNo national route does not prove absolute\nunavailability, but non-routine access must never be\nimplied.",
      "lineHeight": 1.25,
      "baseline": 14,
      "customData": {
        "semanticId": "node.nonroutine.body"
      }
    },
