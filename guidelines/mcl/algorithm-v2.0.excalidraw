      "isDeleted": false,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 2,
      "text": "Use current SmPC and local SACT protocol for formulation, dose, schedule, modifications and administration.\nAssess infection, vaccination, viral screening, interactions, bleeding, cardiac, renal and tumour-lysis risk.\nUse dedicated CAR-T and bispecific toxicity pathways. Human pharmacy verification remains mandatory.\nIndependent clinical review and release pharmacy verification complete.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use current SmPC and local SACT protocol for formulation, dose, schedule, modifications and administration.\nAssess infection, vaccination, viral screening, interactions, bleeding, cardiac, renal and tumour-lysis risk.\nUse dedicated CAR-T and bispecific toxicity pathways. Human pharmacy verification remains mandatory.\nIndependent clinical review and release pharmacy verification complete.",
      "lineHeight": 1.25,
      "baseline": 14,
      "customData": {
        "semanticId": "node.safety.body"
      }
    },
