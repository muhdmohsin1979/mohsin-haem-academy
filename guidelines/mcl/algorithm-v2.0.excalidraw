    {
      "id": "804910bddf6f73247dbd",
      "type": "text",
      "x": 54,
      "y": 185,
      "width": 703,
      "height": 52,
      "angle": 0,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
