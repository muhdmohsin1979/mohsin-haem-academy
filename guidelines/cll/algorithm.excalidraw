    },
    {
      "id": "83d56b0497c6f02050c6",
      "type": "text",
      "x": 54,
      "y": 1351.5,
      "width": 892,
      "height": 169,
      "angle": 0,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 98948147,
      "version": 1,
      "versionNonce": 29066124,
      "isDeleted": false,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "fontSize": 15,
      "fontFamily": 2,
      "text": "Evidence, marketing authorisation, NICE recommendation and NHS funding are separate determinations.\nTA429 Ibrutinib \u00b7 TA689 Acalabrutinib \u00b7 TA931 Zanubrutinib \u00b7 TA561 Venetoclax\u2013rituximab\nTA796: (a) del(17p)/TP53 when a B-cell receptor pathway inhibitor is unsuitable, or after progression on one; or\n(b) no del(17p)/TP53 after progression following both chemoimmunotherapy and a B-cell receptor pathway inhibitor.\nTA1173: pirtobrutinib for adults with R/R CLL after a BTKi, only when covalent-BTKi retreatment, including after a\nfixed-duration regimen, is not clinically appropriate.\nAt the cut-off, NHS England access remained through interim Blueteq funding; routine-budget implementation was due\nby 29 September 2026. The broader MHRA licence does not widen funding.\nEngland access is not a single UK-wide entitlement. Check SmPC, Blueteq and local policy.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "96e45a2e0cbaca5a22fc",
      "originalText": "Evidence, marketing authorisation, NICE recommendation and NHS funding are separate determinations.\nTA429 Ibrutinib \u00b7 TA689 Acalabrutinib \u00b7 TA931 Zanubrutinib \u00b7 TA561 Venetoclax\u2013rituximab\nTA796: (a) del(17p)/TP53 when a B-cell receptor pathway inhibitor is unsuitable, or after progression on one; or\n(b) no del(17p)/TP53 after progression following both chemoimmunotherapy and a B-cell receptor pathway inhibitor.\nTA1173: pirtobrutinib for adults with R/R CLL after a BTKi, only when covalent-BTKi retreatment, including after a\nfixed-duration regimen, is not clinically appropriate.\nAt the cut-off, NHS England access remained through interim Blueteq funding; routine-budget implementation was due\nby 29 September 2026. The broader MHRA licence does not widen funding.\nEngland access is not a single UK-wide entitlement. Check SmPC, Blueteq and local policy.",
      "lineHeight": 1.25,
      "baseline": 15
    },
