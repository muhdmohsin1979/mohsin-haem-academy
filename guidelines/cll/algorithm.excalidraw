      "originalText": "NICE RECOMMENDATIONS AND NHS ENGLAND ACCESS \u00b7 26 JULY 2026",
      "lineHeight": 1.25,
      "baseline": 17
    },
    {
      "id": "96e45a2e0cbaca5a22fc",
      "type": "rectangle",
      "x": 44,
      "y": 1274,
      "width": 912,
      "height": 324,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
